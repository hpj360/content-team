{
  "version": 1,
  "name": "creative-gates",
  "description": "创作质量门行为契约：给定规范化输入，断言审查结论（通过/问题编码）。行为契约式 evals，参照公开导演/分镜 skill 的 evals/evals.json 模式。",
  "cases": [
    {
      "id": "novel-ok",
      "stage": "NOVEL",
      "input": {
        "title": "山海纪",
        "logline": "少年为寻父闯入妖域",
        "chapters": [{"body": "第一章正文……", "word_count": 3000}]
      },
      "expect": {"passed": true, "error_codes": [], "warn_codes": []}
    },
    {
      "id": "novel-no-chapter",
      "stage": "NOVEL",
      "input": {"title": "山海纪", "logline": "少年寻父", "chapters": []},
      "expect": {"passed": false, "error_codes": ["N004"], "warn_codes": []}
    },
    {
      "id": "novel-short-chapter-warn",
      "stage": "NOVEL",
      "input": {
        "title": "山海纪",
        "logline": "少年寻父",
        "chapters": [{"body": "很短的一章", "word_count": 10}]
      },
      "expect": {"passed": true, "error_codes": [], "warn_codes": ["N006"]}
    },
    {
